<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>I Love You ❤️</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    overflow: hidden;
    height: 100vh;
    background: linear-gradient(135deg, #ff758c, #ff7eb3, #8e44ad);
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: Arial, sans-serif;
}

.container {
    text-align: center;
    color: white;
    z-index: 10;
}

h1 {
    font-size: 55px;
    animation: muncul 2s ease-in-out infinite alternate;
    text-shadow: 0 0 20px white;
}

p {
    font-size: 22px;
    margin-top: 15px;
    animation: muncul 2s ease-in-out infinite alternate;
}

.heart {
    position: relative;
    width: 120px;
    height: 120px;
    margin: 30px auto;
    background: #ff1744;
    transform: rotate(-45deg);
    animation: detak 1s infinite;
    box-shadow: 0 0 40px #ff1744;
}

.heart::before,
.heart::after {
    content: "";
    position: absolute;
    width: 120px;
    height: 120px;
    background: #ff1744;
    border-radius: 50%;
}

.heart::before {
    top: -60px;
    left: 0;
}

.heart::after {
    left: 60px;
    top: 0;
}

.floating-heart {
    position: absolute;
    color: white;
    font-size: 25px;
    animation: naik 6s linear infinite;
    opacity: 0.8;
}

@keyframes detak {
    0%, 100% {
        transform: rotate(-45deg) scale(1);
    }
    50% {
        transform: rotate(-45deg) scale(1.2);
    }
}

@keyframes muncul {
    from {
        transform: scale(1);
        opacity: 0.7;
    }
    to {
        transform: scale(1.08);
        opacity: 1;
    }
}

@keyframes naik {
    0% {
        transform: translateY(100vh) rotate(0deg);
        opacity: 0;
    }

    20% {
        opacity: 1;
    }

    100% {
        transform: translateY(-120vh) rotate(360deg);
        opacity: 0;
    }
}
</style>
</head>

<body>

<div class="container">
    <div class="heart"></div>

    <h1>I LOVE YOU ❤️</h1>
    <p>Forever and always 💕</p>
</div>

<script>
function buatHati() {
    const hati = document.createElement("div");

    hati.className = "floating-heart";
    hati.innerHTML = "❤️";

    hati.style.left = Math.random() * 100 + "vw";
    hati.style.fontSize = (15 + Math.random() * 35) + "px";
    hati.style.animationDuration = (4 + Math.random() * 5) + "s";

    document.body.appendChild(hati);

    setTimeout(() => {
        hati.remove();
    }, 9000);
}

setInterval(buatHati, 300);
</script>

</body>
</html>